# LoKey Environment Variables
# Copy this file to .env and fill in your values

# Supabase
VITE_SUPABASE_URL="https://acwgndxotztkqylryszk.supabase.co"
VITE_SUPABASE_ANON_KEY="your_supabase_anon_key_here"

# OpenAI (used for ID verification + AI chat suggestions)
VITE_OPENAI_API_KEY="your_openai_api_key_here"

# Gemini (used for intro video generation)
GEMINI_API_KEY="your_gemini_api_key_here"

# Stripe
# In test mode, set VITE_STRIPE_TEST_MODE=true — no real payment will be taken
# In production, set VITE_STRIPE_TEST_MODE=false and paste your Payment Link URL below
VITE_STRIPE_TEST_MODE="true"
VITE_STRIPE_PAYMENT_LINK="https://buy.stripe.com/your_payment_link_here"

# App
VITE_APP_URL="http://localhost:3000"
